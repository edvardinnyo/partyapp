# Copy to .env and fill in. The .env file is never committed.
# List every key here without its value. Only EXPO_PUBLIC_* variables reach the app,
# and they end up inside the app bundle, so never put secrets in them.

# Supabase project URL and publishable key (Dashboard → Project Settings → API Keys).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Build-time only, never in the app code: the Google Maps key for Android builds (EAS).
# Expo Go needs none. Restrict it in Google Cloud to the Maps SDK for Android and to the app's
# package name + signing certificate, then store it as an EAS environment variable.
GOOGLE_MAPS_ANDROID_API_KEY=
